// Prisma Schema for Hotel Rama Inn
// Compatible with MySQL (Hostinger shared hosting default) and easily configurable for PostgreSQL

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model RoomCategory {
  id                   String                  @id @default(uuid()) @db.VarChar(36)
  name                 String                  @db.VarChar(120)
  slug                 String                  @unique @db.VarChar(120)
  description          String?                 @db.Text
  max_adults           Int                     @default(2)
  max_children         Int                     @default(1)
  total_units          Int                     @default(1)
  base_price_per_night Decimal                 @db.Decimal(10, 2)
  tax_percent          Decimal                 @default(12.00) @db.Decimal(5, 2)
  amenities            String                  @default("[]") @db.Text
  images               String                  @default("[]") @db.Text
  is_active            Boolean                 @default(true)
  created_at           DateTime                @default(now())
  updated_at           DateTime                @updatedAt

  bookings             Booking[]
  calendar_overrides   RoomCalendarOverride[]

  @@map("room_categories")
}

model RoomCalendarOverride {
  id                 String       @id @default(uuid()) @db.VarChar(36)
  room_category_id   String       @db.VarChar(36)
  override_date      DateTime     @db.Date
  available_units    Int?
  is_blocked         Boolean      @default(false)
  price_override     Decimal?     @db.Decimal(10, 2)
  notes              String?      @db.VarChar(255)
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt

  room_category      RoomCategory @relation(fields: [room_category_id], references: [id], onDelete: Cascade)

  @@index([room_category_id])
  @@index([override_date])
  @@map("room_calendar_overrides")
}

model Booking {
  id                    String               @id @default(uuid()) @db.VarChar(36)
  booking_reference     String               @unique @db.VarChar(30)
  room_category_id      String               @db.VarChar(36)
  check_in_date         DateTime             @db.Date
  check_out_date        DateTime             @db.Date
  total_nights          Int
  rooms_count           Int                  @default(1)
  adults                Int                  @default(1)
  children              Int                  @default(0)
  guest_name            String               @db.VarChar(200)
  guest_email           String               @db.VarChar(254)
  guest_phone           String               @db.VarChar(20)
  special_requests      String?              @db.Text
  expected_checkin_time String?              @db.VarChar(20)
  price_per_night       Decimal              @db.Decimal(10, 2)
  room_total            Decimal              @db.Decimal(10, 2)
  tax_amount            Decimal              @db.Decimal(10, 2)
  final_payable         Decimal              @db.Decimal(10, 2)
  currency              String               @default("INR") @db.VarChar(3)
  status                String               @default("PENDING_PAYMENT") @db.VarChar(30)
  payment_status        String               @default("INITIATED") @db.VarChar(30)
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  hold_expires_at       DateTime?

  room_category         RoomCategory         @relation(fields: [room_category_id], references: [id], onDelete: Restrict)
  transactions          PaymentTransaction[]

  @@index([room_category_id])
  @@index([check_in_date])
  @@index([check_out_date])
  @@index([status])
  @@index([guest_email])
  @@index([hold_expires_at])
  @@map("bookings")
}

model PaymentTransaction {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  booking_id         String    @db.VarChar(36)
  gateway_order_id   String?   @db.VarChar(200)
  gateway_payment_id String?   @db.VarChar(200)
  gateway_signature  String?   @db.VarChar(500)
  amount             Decimal   @db.Decimal(10, 2)
  currency           String    @default("INR") @db.VarChar(3)
  status             String    @default("PENDING") @db.VarChar(30)
  provider           String    @default("razorpay") @db.VarChar(30)
  payload            String?   @db.Text
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  booking            Booking   @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@index([booking_id])
  @@index([gateway_order_id])
  @@index([gateway_payment_id])
  @@index([status])
  @@map("payment_transactions")
}

model AdminUser {
  id            String    @id @default(uuid()) @db.VarChar(36)
  username      String    @unique @db.VarChar(60)
  email         String    @unique @db.VarChar(255)
  full_name     String    @db.VarChar(120)
  password_hash String    @db.VarChar(255)
  role          String    @default("STAFF") @db.VarChar(30)
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  last_login_at DateTime?

  @@map("admin_users")
}

model AdminAuditLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  timestamp   DateTime @default(now())
  user_id     String?  @db.VarChar(64)
  user_name   String   @db.VarChar(120)
  user_role   String   @db.VarChar(30)
  action      String   @db.VarChar(60)
  entity_type String?  @db.VarChar(50)
  entity_id   String?  @db.VarChar(100)
  details     String   @db.Text

  @@index([timestamp])
  @@index([user_name])
  @@index([user_role])
  @@index([action])
  @@map("admin_audit_logs")
}

